{
  "name": "@shop/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "generate": "openapi-typescript node_modules/@shop/contracts/openapi.json --output src/generated/schema.ts",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@shop/config-eslint": "workspace:*",
    "@shop/config-ts": "workspace:*",
    "@shop/contracts": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "openapi-typescript": "7.13.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  }
}
