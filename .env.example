# Copy to .env and adjust. Never commit .env.
# Values below are for local development only.

# Docker Compose (local infrastructure)
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=shop
POSTGRES_PORT=5432
REDIS_PORT=6379

# Application connection strings (must match the values above)
DATABASE_URL=postgres://shop:change-me-local-only@127.0.0.1:5432/shop
REDIS_URL=redis://127.0.0.1:6379
